# Copy to .env and adjust. Docker Compose also reads this file for variable substitution.

SECRET_KEY=change-me-to-a-long-random-string
DEBUG=0
ALLOWED_HOSTS=localhost,127.0.0.1,web

POSTGRES_DB=pakwheels
POSTGRES_USER=pakwheels
POSTGRES_PASSWORD=pakwheels
# Django on your machine → localhost. Docker Compose overrides this to db.
POSTGRES_HOST=localhost

CELERY_BROKER_URL=redis://127.0.0.1:6379/0
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/0
